SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-dedicated-sender@gmail.com
SMTP_PASSWORD=your-google-app-password
# Required as true when NODE_ENV=production; serve only behind HTTPS.
COOKIE_SECURE=false
MAIL_FROM=RETURNO <your-dedicated-sender@gmail.com>
# For the Docker deployment, point this DNS name to the server's stable public IP.
RETURNO_HOSTNAME=returno.example.org
# Vercel/Supabase deployment only. Keep the elevated server key server-side.
# Use Supabase's transaction pooler connection string for Vercel; URL-encode special password characters.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
SUPABASE_URL=https://your-project.supabase.co
# Server-only Supabase secret key (sb_secret_...) or legacy service_role JWT.
SUPABASE_SECRET_KEY=your-server-only-secret-key
SUPABASE_STORAGE_BUCKET=retorno-images
# Optional when Supabase's certificate is not in the runtime trust store.
# Download the root CA from Supabase Dashboard > Database > Settings > SSL Configuration.
# Use one form only; local path for development, PEM content (with \n) for hosted env vars.
# DATABASE_SSL_CA_FILE=./supabase-root-ca.crt
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# Required as a stable secret on Vercel; locally first startup creates data/verification-code.key if unset.
# RETURNO_CODE_PEPPER=64-hex-characters-from-a-random-generator
# Set COOKIE_SECURE=true in Vercel. Vercel automatically selects Postgres mode and fails closed if DATABASE_URL is missing.
