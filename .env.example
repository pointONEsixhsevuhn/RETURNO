SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-dedicated-sender@gmail.com
SMTP_PASSWORD=your-google-app-password
# Required as true when NODE_ENV=production; serve only behind HTTPS.
COOKIE_SECURE=false
MAIL_FROM=RETURNO <your-dedicated-sender@gmail.com>
# For the Docker deployment, point this DNS name to the server's stable public IP.
RETURNO_HOSTNAME=returno.example.org
# Optional stable secret. Locally, first startup creates data/verification-code.key if unset.
# RETURNO_CODE_PEPPER=64-hex-characters-from-a-random-generator
