{
  "name": "retorno",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "NVSU Bayombong Lost & Found System",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env scripts/start.js",
    "admin": "node --env-file-if-exists=.env scripts/admin.js",
    "admin:reset": "node --env-file-if-exists=.env scripts/admin-recovery.js",
    "db:backup": "node scripts/database.js backup",
    "db:verify": "node scripts/database.js verify",
    "db:restore": "node scripts/database.js restore",
    "demo": "node scripts/demo.js",
    "verify:workflow": "node scripts/verify-workflow.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "prettier": "^3.9.9"
  },
  "dependencies": {
    "nodemailer": "^10.0.16",
    "sharp": "^0.35.5"
  }
}
